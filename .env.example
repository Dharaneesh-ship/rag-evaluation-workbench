# RAG Framework — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Voyage AI (reranker / embeddings) ─────────────────────
VOYAGE_API_KEY=pa-...

# ── Cohere (optional reranker, V2) ────────────────────────
COHERE_API_KEY=...

# ── Storage paths ─────────────────────────────────────────
# Directory where SQLite databases and FAISS index files are stored.
RAG_DATA_DIR=./data

# ── Embedding settings ────────────────────────────────────
# What "server_default" resolves to for a request's embedding_provider.
# The exact name matters: RAG_EMBEDDING_PROVIDER_DEFAULT is what
# rag/app/mcp_server/retrieval_config.py actually reads (see README.md
# §"Configuration" and 附录 CH.2/CI.1/CI.3 — this used to be misnamed
# EMBEDDING_PROVIDER here, a dead variable no code ever read, silently
# leaving every request at BM25-only regardless of this file's contents).
RAG_EMBEDDING_PROVIDER_DEFAULT=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── LLM settings ──────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ── Retrieval settings ────────────────────────────────────
RETRIEVAL_TOP_K=5
# What "server_default" resolves to for a request's reranker_provider.
# "none" (or unset) disables reranking — there is no separate enable/
# disable flag; RERANK_ENABLED (previously here) was likewise a dead
# variable no code ever read (附录 CH.2/CI.1/CI.3).
RAG_RERANKER_PROVIDER_DEFAULT=voyage

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
